{
  "automationModes": {
    "blocked": "No automation until purpose, account, output path, and risk are classified.",
    "draft_only": "The app can produce drafts, prompts, scripts, or assets, but publishing and account actions require review.",
    "human_approve": "The app can be prepared by an agent, but final send, post, publish, purchase, or account-changing action requires explicit approval.",
    "read_only": "The app can be inventoried and referenced, but no app interaction or content capture is allowed without a narrower approval.",
    "reviewed_capture": "The app can produce artifacts only after the operator reviews what will be captured and where it will be stored."
  },
