  "contentStages": [
    {
      "id": "research",
      "name": "Research and source gathering",
      "recordTypes": ["source", "research_note", "evidence"],
      "requiredEvidence": [
        "source url or local path",
        "capture timestamp",
        "owner",
        "sensitivity label"
      ]
    },
    {
      "id": "strategy",
      "name": "Offer, angle, and prompt strategy",
      "recordTypes": ["offer", "content_campaign", "prompt", "decision"],
      "requiredEvidence": ["target segment", "offer id", "campaign goal", "approval status"]
    },
    {
      "id": "generation",
      "name": "AI text, image, audio, and video generation",
      "recordTypes": ["asset", "prompt", "generation_run", "artifact"],
      "requiredEvidence": ["source app", "model or tool label", "prompt pointer", "export path"]
    },
    {
      "id": "editing",
      "name": "Packaging, edit, and review",
      "recordTypes": ["asset_revision", "review", "artifact", "evidence"],
      "requiredEvidence": ["input asset", "output asset", "reviewer", "change summary"]
    },
    {
      "id": "publishing",
      "name": "Distribution and scheduled publishing",
      "recordTypes": ["publish_event", "approval", "content_campaign"],
      "requiredEvidence": ["target channel", "account label", "scheduled time", "human approval"]
    },
    {
      "id": "measurement",
      "name": "Analytics and learning",
      "recordTypes": ["analytics_snapshot", "experiment", "decision"],
      "requiredEvidence": ["metric source", "time window", "result", "next decision"]
    },
    {
      "id": "projection",
      "name": "AzA memory and VANTA-Brain projection",
      "recordTypes": ["memory_record", "projection", "decision"],
      "requiredEvidence": ["canonical AzA id", "redaction status", "projection approval"]
    }
  ],
